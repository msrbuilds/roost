---
const brands = [
  { name: 'Skool', image: 'skool.png', wordmark: false },
  { name: 'Circle', image: 'circle.svg', wordmark: true },
  { name: 'Mighty Networks', image: 'mighty.svg', wordmark: false },
  { name: 'Discord', image: 'discord.svg', wordmark: true },
  { name: 'Discourse', image: 'discourse.svg', wordmark: true },
  { name: 'Slack', image: 'slack.svg', wordmark: false },
];
---
<div class="alternatives-marquee" data-logo-marquee aria-label="Alternative community platforms">
  <div class="alternatives-heading"><span class="small-label">AN OPEN-SOURCE ALTERNATIVE TO</span></div>
  <ul class="sr-only alternatives-list" aria-label="Alternative platforms">{brands.map(brand => <li>{brand.name}</li>)}</ul>
  <button class="alternatives-window" type="button" data-marquee-pause disabled aria-label="Pause scrolling logos" aria-pressed="false" aria-describedby="alternatives-motion-help"><span class="alternatives-track" aria-hidden="true">
    {[0, 1].map(copy => <span class="alternatives-group" aria-hidden={copy === 1 ? 'true' : undefined}>{brands.map(brand => <span><img src={`/alternatives/${brand.image}`} alt="" width={brand.wordmark ? 145 : 32} height="32" loading="eager" class:list={[brand.wordmark && 'brand-wordmark']} />{!brand.wordmark && <span>{brand.name}</span>}</span>)}</span>)}
  </span></button>
  <span class="sr-only" id="alternatives-motion-help">Activate the logo strip to pause or resume scrolling. It also pauses on hover or keyboard focus.</span>
  <p>Paid, free, and open-source platforms. Your community has another option.<br /><span>Names and marks belong to their owners. No affiliation or endorsement.</span></p>
</div>
