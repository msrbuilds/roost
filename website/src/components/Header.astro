---
import Icon from './Icon.astro';
import { repository } from '../data/site';
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="header-inner container">
    <a class="brand" href="/" aria-label="Roost home"><img src="/brand.png" alt="" width="36" height="36" /><span>roost<span class="brand-period">.</span></span></a>
    <nav class="desktop-nav" aria-label="Main navigation">
      <a href="/features/" aria-current={path.startsWith('/features') ? 'page' : undefined}>Features</a>
      <a href="/docs/" aria-current={path.startsWith('/docs') ? 'page' : undefined}>Documentation</a>
      <a href={repository}>GitHub <Icon name="external" size={14} /></a>
    </nav>
    <div class="header-actions">
      <button class="search-trigger" disabled data-search-open aria-label="Search documentation Ctrl K" aria-keyshortcuts="Control+k Meta+k"><Icon name="search" size={18} /><span>Search documentation</span><kbd data-search-shortcut aria-hidden="true">Ctrl K</kbd></button>
      <a class="button button-small header-cta" href="/docs/self-hosted-setup/">Get started <Icon name="arrow" size={16} /></a>
      <button class="menu-trigger" disabled aria-expanded="false" aria-controls="mobile-navigation" aria-label="Open navigation"><span></span><span></span></button>
    </div>
  </div>
  <nav id="mobile-navigation" class="mobile-navigation" aria-label="Mobile navigation" hidden>
    <a href="/features/">Features</a><a href="/docs/">Documentation</a><a href={repository}>GitHub ↗</a><a href="/docs/self-hosted-setup/">Get started →</a>
  </nav>
</header>
