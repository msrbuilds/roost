---
import ScreenshotSlider from './ScreenshotSlider.astro';
import week from '../assets/demo/calendar-desktop-week.jpg';
import agenda from '../assets/demo/calendar-desktop-agenda.jpg';
const { compact = false } = Astro.props;
const screens = [
  { label: 'Week view', image: week, alt: 'Roost desktop week calendar with day columns, a community co-working event, and upcoming event details.', description: 'Plan the week with a clear view of upcoming community events.' },
  { label: 'Agenda view', image: agenda, alt: 'Roost desktop agenda with a sample community event, group filters, and upcoming event details.', description: 'Switch to the agenda for event details and quick RSVPs.' },
];
---
<div class:list={['calendar-preview', { 'calendar-preview-compact': compact }]}>
  <div class="calendar-preview-copy"><span class="small-label">A PLACE TO COME TOGETHER</span><h3>Make time for<br /><em>your community.</em></h3><p>Plan meetups, workshops, and community calls in one shared calendar. Browse the week ahead or switch to a simple agenda.</p></div>
  <ScreenshotSlider id={compact ? 'home-calendar' : 'feature-calendar'} label="Community events showcase" screens={screens} tablet />
</div>
