---
import ScreenshotSlider from './ScreenshotSlider.astro';
import week from '../assets/demo/calendar-tablet-week.jpg';
import agenda from '../assets/demo/calendar-tablet-agenda.jpg';
const { compact = false } = Astro.props;
const screens = [
  { label: 'Week view', image: week, alt: 'Roost calendar on a tablet with seven readable day columns and a community co-working event.', description: 'Plan the week with a clear view of upcoming community events.' },
  { label: 'Agenda view', image: agenda, alt: 'Roost tablet calendar with an agenda, group filters, and event details including RSVP options.', description: 'Switch to the agenda for event details and quick RSVPs.' },
];
---
<div class:list={['calendar-preview', { 'calendar-preview-compact': compact }]}>
  <div class="calendar-preview-copy"><span class="small-label">EVENTS ON ANY SCREEN</span><h3>Keep your community in sync.</h3><p>Browse the week ahead or switch to a compact agenda. Your community's next gathering is easy to find, from desktop to tablet to phone.</p><span class="calendar-preview-note">Two views. One shared calendar.</span></div>
  <ScreenshotSlider id={compact ? 'home-calendar' : 'feature-calendar'} label="Calendar on a tablet" screens={screens} tablet />
</div>
