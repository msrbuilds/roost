---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import week from '../assets/demo/calendar-mobile-week.jpg';
import agenda from '../assets/demo/calendar-mobile-agenda.jpg';
const { compact = false } = Astro.props;
const views = [
  { label: 'Week view', image: week, alt: 'Roost calendar on a phone with fully visible day labels and a compact time column.', linkLabel: 'Open full-size mobile week screenshot' },
  { label: 'Agenda view', image: agenda, alt: 'Roost calendar on a phone with a compact agenda, readable event dates and times, and group filters.', linkLabel: 'Open full-size mobile agenda screenshot' },
];
---
<div class:list={['calendar-preview', { 'calendar-preview-compact': compact }]}>
  <div class="calendar-preview-copy"><span class="small-label">EVENTS ON ANY SCREEN</span><h3>Keep your community in sync.</h3><p>Browse the week ahead or switch to a compact agenda. Your community's next gathering is easy to find, even on a phone.</p></div>
  <div class="calendar-mobile-shots">{views.map(view => <figure><Image src={view.image} alt={view.alt} width={390} widths={[240, 390]} sizes="(max-width: 800px) 43vw, 220px" format="webp" loading="lazy" /><figcaption><strong>{view.label}</strong><a class="text-link" href={view.image.src} target="_blank" rel="noopener noreferrer" aria-label={view.linkLabel}>Full size <Icon name="external" size={13} /></a></figcaption></figure>)}</div>
</div>
