---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
interface Props { label: string; image: ImageMetadata; dark?: ImageMetadata; alt: string; admin?: boolean; }
const { label, image, dark, alt, admin = false } = Astro.props;
const variants = [{ mode: 'light', image }, ...(dark ? [{ mode: 'dark', image: dark }] : [])];
---
<div data-screenshot-preview>
  {dark && <div class="screenshot-appearance" role="group" aria-label={`${label} screenshot appearance`}><span>Appearance</span><button type="button" data-screenshot-mode="light" aria-pressed="true" disabled>Light</button><button type="button" data-screenshot-mode="dark" aria-pressed="false" disabled>Dark</button></div>}
  {variants.map(variant => <figure data-screenshot-variant={variant.mode} hidden={variant.mode !== 'light'}>
    <a class="tour-screenshot-link" href={variant.image.src} target="_blank" rel="noopener noreferrer" aria-label={`Open full-size ${label.toLowerCase()} screenshot in ${variant.mode} mode`}><Image src={variant.image} alt={`${alt} (${variant.mode} mode)`} width={1440} widths={[640, 1000, 1440]} sizes="(max-width: 480px) calc(100vw - 74px), (max-width: 800px) calc(100vw - 82px), (max-width: 1344px) calc(100vw - 146px), 1198px" format="webp" loading="lazy" /></a>
    <figcaption class="tour-caption-footer"><span>{admin ? 'Local sample installation · admin workspace' : 'Live read-only demo · fictional sample community'} · {variant.mode} mode</span><a class="text-link" href={variant.image.src} target="_blank" rel="noopener noreferrer">Open full-size screenshot <Icon name="external" size={14} /></a></figcaption>
  </figure>)}
</div>
