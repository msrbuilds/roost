---
import { Image } from 'astro:assets';
import classrooms from '../assets/demo/classrooms.jpg';
---
<figure class="product-preview">
  <div class="preview-caption"><span class="status-dot"></span> YOUR COMMUNITY / YOUR DOMAIN / YOUR RULES</div>
  <div class="product-preview-visual"><div class="product-preview-frame"><div class="window-bar"><div class="window-dots"><i></i><i></i><i></i></div><span>A LOOK INSIDE ROOST</span><span>↗</span></div><Image src={classrooms} alt="Roost’s classroom directory, showing searchable learning groups with community banners and stacked classroom details." width={1440} widths={[640, 1000, 1440]} sizes="(max-width: 800px) 92vw, 1200px" format="webp" loading="eager" fetchpriority="high" /></div>
  <div class="preview-sticker"><span aria-hidden="true">↗</span><div>Your community.<br /><strong>Your own platform.</strong></div></div></div>
  <figcaption>Roost · sample community</figcaption>
</figure>
