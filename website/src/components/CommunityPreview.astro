---
import ScreenshotSlider from './ScreenshotSlider.astro';
import feed from '../assets/demo/feed.jpg';
import classrooms from '../assets/demo/classrooms.jpg';
import lessons from '../assets/demo/lesson.jpg';
import calendar from '../assets/demo/calendar.jpg';
import messages from '../assets/demo/messages.jpg';
import admin from '../assets/admin/dashboard.jpg';
const screens = [
  { label: 'Community', image: feed, alt: 'Roost community feed with pinned posts, member conversations, and a contributor leaderboard.', description: 'Conversations, shared ideas, and the people who make your community.' },
  { label: 'Classrooms', image: classrooms, alt: 'Roost classroom directory with banners and stacked classroom cards.', description: 'Give your courses and learning groups a place to belong.' },
  { label: 'Lessons', image: lessons, alt: 'Roost lesson with module navigation, video, and a discussion area.', description: 'Bring lessons, course progress, and discussions together.' },
  { label: 'Calendar', image: calendar, alt: 'Roost calendar with a sample community event and upcoming event details.', description: 'A shared calendar for your community’s next gathering.' },
  { label: 'Messaging', image: messages, alt: 'Roost messaging with a fictional member conversation.', description: 'Keep member connections going beyond the community feed.' },
  { label: 'Administration', image: admin, alt: 'Roost admin dashboard with community totals, activity, and contributor points.', description: 'Manage your community from your own administration dashboard.' },
];
---
<div class="product-preview">
  <ScreenshotSlider id="hero-showcase" label="Roost product showcase" screens={screens} />
  <p class="showcase-provenance">Real Roost screens · fictional sample community · select a screenshot to view full size</p>
</div>
