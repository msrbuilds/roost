---
import { Image } from 'astro:assets';
import classrooms from '../assets/classrooms.png';
---
<figure class="product-preview">
  <div class="preview-caption"><span class="status-dot"></span> YOUR PEOPLE. A PLACE TO LEARN AND BELONG.</div>
  <div class="product-preview-visual"><div class="product-preview-frame"><div class="window-bar"><div class="window-dots"><i></i><i></i><i></i></div><span>A LOOK INSIDE ROOST</span><span>↗</span></div><Image src={classrooms} alt="Roost’s classroom directory, showing searchable learning groups with community banners and join buttons." width={1120} widths={[560, 840, 1120]} sizes="(max-width: 800px) 92vw, 48vw" format="webp" loading="eager" fetchpriority="high" /></div>
  <div class="preview-sticker"><span>✳</span><div>A place to learn.<br /><strong>A place to belong.</strong></div></div></div>
  <figcaption>Roost in action · example community</figcaption>
</figure>
