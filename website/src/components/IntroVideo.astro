---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import poster from '../assets/roost-intro-thumbnail.jpg';
---
<section class="product-preview intro-video" data-intro-video aria-labelledby="intro-video-heading">
  <div class="intro-video-topline"><h2 id="intro-video-heading">Meet Roost</h2><span>PRODUCT OVERVIEW</span></div>
  <div class="intro-video-stage" data-video-stage>
    <button class="intro-video-poster" type="button" data-video-play disabled aria-label="Watch the Roost intro video">
      <Image src={poster} alt="" width={1280} widths={[640, 960, 1280]} sizes="(max-width: 480px) calc(100vw - 74px), (max-width: 800px) calc(100vw - 82px), (max-width: 1344px) calc(100vw - 146px), 1198px" format="webp" loading="lazy" />
      <span class="intro-video-play" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="m9 5 11 7-11 7Z" /></svg></span>
      <span class="intro-video-label" aria-hidden="true">Watch the Roost intro</span>
    </button>
  </div>
  <p class="sr-only" data-video-status role="status"></p>
  <div class="intro-video-caption"><span>A closer look at your open-source community platform.</span><a class="text-link" href="https://www.youtube.com/watch?v=XVmHSLuBeNU" target="_blank" rel="noopener noreferrer">Watch on YouTube <Icon name="external" size={15} /></a></div>
</section>
