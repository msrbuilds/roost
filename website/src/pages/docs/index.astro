---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { guides, guideGroups, repository } from '../../data/site';
---
<Base title="Documentation" description="Install, configure, and operate your own Roost community. Guides for Docker, Dokploy, Supabase, email, backups, and recovery.">
  <main id="main" data-pagefind-body><section class="container page-intro docs-intro"><span class="small-label">THE GUIDEBOOK TO YOUR NEW HOME</span><h1>Let’s get you <em>settled in.</em></h1><p>From your first install to the backup you hope you never need. Practical guides for running your own Roost community.</p></section>
    <section class="container docs-start"><div><span class="small-label">NEW HERE?</span><h2>Start with the big picture.</h2><p>Choose a deployment path, check the prerequisites, and make your first admin account.</p><a class="button" href="/docs/self-hosted-setup/">Getting started <Icon name="arrow" size={18} /></a></div><div class="docs-start-code"><span class="code-label">YOUR TERMINAL</span><pre><code><span>git clone</span> https://github.com/msrbuilds/roost.git<br /><span>cd</span> roost<br /><span>bash</span> install.sh</code></pre><small>Node.js 22+ · Docker for VPS deployments</small></div></section>
    <section class="container docs-directory">{guideGroups.map((group) => <div class="doc-group"><h2>{group}</h2><div class="doc-card-grid">{guides.filter((guide) => guide.group === group).map((guide) => <a class="doc-card" href={`/docs/${guide.id}/`}><h3>{guide.title}<Icon name="arrow" size={18} /></h3><p>{guide.description}</p></a>)}</div></div>)}</section>
    <div class="container docs-help"><p>Found something we can make clearer?</p><a href={`${repository}/issues`}>Help improve the guidebook ↗</a></div>
  </main>
</Base>
