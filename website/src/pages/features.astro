---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { features, liveDemo } from '../data/site';
import FeatureTour from '../components/FeatureTour.astro';
---
<Base title="Open-source community features" description="Explore Roost’s community feed, classrooms, private groups, direct messaging, events, showcases, and admin tools.">
  <main id="main"><section class="container page-intro"><span class="small-label">YOUR COMMUNITY TOOLKIT</span><h1>Everything connects.<br /><em>You stay in control.</em></h1><p>The community features you expect from platforms like Skool and Circle, built on an open-source foundation. Explore real member and admin screens, then choose what to enable.</p><div class="button-row product-actions"><a class="button" href={liveDemo}>Try Live Demo <Icon name="external" size={17} /></a><a class="text-link" href="/docs/self-hosted-setup/">Self-host Roost <Icon name="arrow" size={18} /></a></div></section>
    <section class="container feature-detail-grid">{features.map((feature) => <article class="feature-detail"><span class="feature-icon"><Icon name={feature.icon} size={27} /></span><span class="small-label">{feature.eyebrow}</span><h2>{feature.title}</h2><p>{feature.text}</p><ul class="check-list">{feature.items.map((item) => <li><Icon name="check" size={17} />{item}</li>)}</ul></article>)}</section>
    <FeatureTour />
    <section class="container comparison-cta"><div><span class="small-label">LOOKING AT YOUR OPTIONS?</span><h2>See how Roost compares.</h2><p>Explore features, operating costs, and the differences between self-hosting and a paid community platform.</p></div><a class="button button-outline" href="/compare/">Roost vs Skool vs Circle <Icon name="arrow" size={18} /></a></section>
    <section class="container feature-note"><h2>Start with what you need.</h2><p>Feature flags let you enable or hide areas such as showcases, live rooms, activations, and leaderboards. Paid memberships are optional and disabled by default; enabling billing requires a configured and tested Stripe integration.</p><a class="text-link" href="/docs/self-hosted-setup/">Read the setup guide <Icon name="arrow" size={18} /></a></section>
    <section class="container final-cta"><div><span class="small-label">FREE TO RUN. FREE TO MAKE YOUR OWN.</span><h2>Your community.<br /><em>Your open foundation.</em></h2></div><a class="button button-light" href="/docs/self-hosted-setup/">Get started <Icon name="arrow" size={18} /></a></section>
  </main>
</Base>
